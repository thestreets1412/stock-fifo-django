# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Django secret key — MUST be a production-grade key of at least 50 random
# characters. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-50-char-random-key

# Debug mode. Defaults to False (fail-closed) when unset. Set to True only
# for local development — never True in production.
DEBUG=False

# Comma-separated list of allowed hostnames. Phase 5 appends the real
# Cloudflare Tunnel domain once it is acquired.
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of trusted CSRF origins, each including the scheme
# (e.g. https://example.com). Intentionally left empty until the real
# domain is acquired in Phase 5 — do not add a placeholder domain here.
CSRF_TRUSTED_ORIGINS=
