# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Django secret key — MUST be a production-grade key of at least 50 random
# characters. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-50-char-random-key

# Debug mode. Defaults to False (fail-closed) when unset. Set to True only
# for local development — never True in production.
DEBUG=False

# Comma-separated list of allowed hostnames. In production this is the
# Cloudflare Tunnel domain plus loopback for local health checks.
ALLOWED_HOSTS=127.0.0.1,localhost,fifo-by-minotaur.uk

# Comma-separated list of trusted CSRF origins, each including the scheme.
# Must match the tunnel hostname exactly or every POST returns 403.
CSRF_TRUSTED_ORIGINS=https://fifo-by-minotaur.uk
