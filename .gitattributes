# Shell scripts must keep LF endings or the shebang breaks on the Pi
# ("bad interpreter: /usr/bin/env bash^M")
*.sh text eol=lf

# Vendored third-party assets are checksummed in scripts/vendor-assets.lock.json.
# Any EOL rewriting would change their bytes and fail -VerifyOnly on a fresh clone.
portfolio/static/portfolio/vendor/** -text
